# ==============================================================================
# MoneyPilot Environment Configuration (Template)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Replace the placeholder values below with your real Supabase project credentials.
#    Find these in your Supabase Dashboard: Project Settings -> API.
# 3. Launch Flutter with the environment file:
#    flutter run -d chrome --dart-define-from-file=.env
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (safe for client-side use)
# NEVER put your secret service_role key here!
SUPABASE_ANON_KEY=your-anon-publishable-key-here
